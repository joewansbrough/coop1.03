// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- ENUMS ---

enum MaintenanceFrequency {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum MaintenanceCategory {
  PLUMBING
  ELECTRICAL
  HVAC
  SAFETY
  GENERAL
  OTHER
}

enum DocumentVisibility {
  PUBLIC
  MEMBERS
  COMMITTEE
  BOARD
  ADMIN
  CUSTOM
  PRIVATE
}

enum DocumentStatus {
  ACTIVE
  ARCHIVED
  SUPERSEDED
}

enum GroupType {
  SYSTEM
  BOARD
  COMMITTEE
  CHAIR
  ADMIN
  MEMBER
  CONTRACTOR
  CUSTOM
}

enum MembershipSource {
  MANUAL
  GOOGLE_SYNC
  SYSTEM
  IMPORT
}

enum PermissionEffect {
  ALLOW
  DENY
}

enum DocumentAccessLevel {
  VIEW
  COMMENT
  EDIT
  MANAGE
}

enum StorageProvider {
  LOCAL
  VERCEL_BLOB
  GOOGLE_DRIVE
  EXTERNAL_LINK
}

// --- MODELS ---

model Cooperative {
  id              String    @id @default(uuid())
  name            String
  slug            String    @unique
  subdomain       String?   @unique
  status          String    @default("ONBOARDING")
  onboardingState String    @default("SETUP")
  settings        Json      @default("{}")
  address         String?
  city            String?
  province        String    @default("BC")
  adminEmail      String?
  launchedAt      DateTime?
  suspendedAt     DateTime?
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  announcements        Announcement[]
  buildings            Building[]
  committees           Committee[]
  events               CoopEvent[]
  documents            Document[]
  maintenanceRequests  MaintenanceRequest[]
  scheduledMaintenance ScheduledMaintenance[]
  dashboardPreferences  DashboardPreference[]
  userPreferences       UserPreference[]
  notifications        Notification[]
  meetingAnalyses      MeetingAnalysis[]
  tenants              Tenant[]
  tenantHistories      TenantHistory[]
  units                Unit[]
  users                User[]
  groups               Group[]
  auditLogs            AuditLog[]
  documentAccessRules  DocumentAccessRule[]
  ragStores            RagStore[]
  driveRoots           CooperativeDriveRoot[]
}

model User {
  id              String   @id @default(uuid())
  cooperativeId   String
  cooperative     Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  email           String
  name            String?
  firstName       String?
  lastName        String?
  isActive        Boolean  @default(true)
  isSystemAdmin   Boolean  @default(false)
  lastLoginAt     DateTime?
  tenantId        String?  @unique
  tenant          Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  googleSubjectId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships     Membership[]
  accessOverrides UserPermissionOverride[]
  auditLogs        AuditLog[]
  documentRules    DocumentAccessRule[]

  @@unique([cooperativeId, email])
  @@index([cooperativeId])
  @@index([email])
}

model Group {
  id               String   @id @default(uuid())
  cooperativeId    String
  cooperative      Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  name             String
  slug             String
  description      String?
  type             GroupType
  isSystem         Boolean  @default(false)
  committeeId      String?
  committee        Committee? @relation(fields: [committeeId], references: [id], onDelete: SetNull)
  googleGroupId    String?
  googleGroupEmail String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  memberships      Membership[]
  permissions      GroupPermission[]
  documentRules    DocumentAccessRule[]

  @@unique([cooperativeId, slug])
  @@index([cooperativeId])
  @@index([committeeId])
}

model Membership {
  id            String   @id @default(uuid())
  cooperativeId String
  userId        String
  groupId       String
  source        MembershipSource @default(MANUAL)
  startsAt      DateTime?
  endsAt        DateTime?
  isActive      Boolean @default(true)
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group         Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([cooperativeId])
  @@index([groupId])
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  category    String
  isSystem    Boolean @default(true)

  groups      GroupPermission[]
  overrides   UserPermissionOverride[]
}

model GroupPermission {
  id            String @id @default(uuid())
  groupId       String
  permissionId  String
  createdAt     DateTime @default(now())

  group         Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([groupId, permissionId])
}

model UserPermissionOverride {
  id            String @id @default(uuid())
  cooperativeId String
  userId        String
  permissionId  String
  effect        PermissionEffect
  reason        String?
  expiresAt     DateTime?
  createdBy     String?
  createdAt     DateTime @default(now())

  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@index([cooperativeId])
  @@index([userId])
}

model Building {
  id            String @id @default(uuid())
  name          String
  code          String?
  address       String?
  sortOrder     Int @default(1)
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  units         Unit[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([cooperativeId])
  @@unique([cooperativeId, name])
}

model DashboardPreference {
  id            String   @id @default(uuid())
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  userEmail     String
  layout        Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([cooperativeId, userEmail])
  @@index([cooperativeId])
}

model UserPreference {
  id            String   @id @default(uuid())
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  userEmail     String
  key           String
  value         Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([cooperativeId, userEmail, key])
  @@index([cooperativeId])
  @@index([userEmail])
}

model Unit {
  id     String @id @default(uuid())
  number String
  type   String // e.g., "1BR", "2BR", "3BR"
  floor  Int    @default(1)
  status String // e.g., "Occupied", "Vacant", "Maintenance"

  // Multi-tenancy
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id])
  buildingId    String?
  building      Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)

  currentTenantId String? @unique
  currentTenant   Tenant? @relation("CurrentResident", fields: [currentTenantId], references: [id])

  maintenanceHistory MaintenanceRequest[]
  occupancyHistory   TenantHistory[]
  scheduledTasks     ScheduledMaintenance[] @relation("ScheduledTasks")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cooperativeId])
  @@index([buildingId])
  @@unique([cooperativeId, number])
}

model CooperativeDriveRoot {
  id            String      @id @default(uuid())
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  folderId      String
  displayName   String?
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([cooperativeId, folderId])
  @@index([cooperativeId])
  @@index([folderId])
}

model Tenant {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  email     String   @unique
  phone     String?
  startDate DateTime // Changed from String to DateTime
  status    String   @default("Current")
  role      String   @default("MEMBER")

  // Multi-tenancy
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id])

  unitId String?
  unit   Unit?   @relation("CurrentResident")

  committees Committee[]     @relation("CommitteeMembers")
  events     CoopEvent[]     @relation("EventAttendees")
  history    TenantHistory[]
  user        User?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TenantHistory {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  unitId   String
  unit     Unit   @relation(fields: [unitId], references: [id])

  // Multi-tenancy
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id])

  startDate  DateTime
  endDate    DateTime?
  moveReason String?
  createdAt  DateTime  @default(now())
}

model MaintenanceRequest {
  id          String @id @default(uuid())
  title       String
  description String
  status      String
  priority    String
  category    String @default("General")

  // Multi-tenancy
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id])

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id])

  tenantId    String?
  requestedBy String? // Email of the tenant who requested
  notes       Json?
  expenses    Json?
  attachments Json?
  aiTriage    Json?
  visualDescription String?
  residentTip String?
  triageReviewedBy String?
  triageReviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id                 String   @id @default(uuid())
  cooperativeId      String
  cooperative        Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  audience           String
  recipientUserEmail String?
  type               String
  severity           String   @default("info")
  title              String
  body               String
  entityType         String?
  entityId           String?
  actionUrl          String?
  readAt             DateTime?
  createdAt          DateTime @default(now())
  readReceipts       NotificationReadReceipt[]

  @@index([cooperativeId])
  @@index([recipientUserEmail])
  @@index([readAt])
  @@index([createdAt])
  @@index([type])
}

model NotificationReadReceipt {
  id             String       @id @default(uuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userEmail      String
  readAt         DateTime     @default(now())

  @@unique([notificationId, userEmail])
  @@index([userEmail])
  @@index([readAt])
}

model Announcement {
  id       String   @id @default(uuid())
  title    String
  content  String
  type     String
  priority String   @default("Medium")
  author   String
  date     DateTime // Changed from String to DateTime

  // Multi-tenancy
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Document {
  id        String   @id @default(uuid())
  title     String
  category  String
  committee String?  @default("")
  url       String
  fileType  String
  author    String   @default("Admin")
  date      DateTime // Changed from String to DateTime
  tags      String[] @default([])
  content   String?
  status    DocumentStatus @default(ACTIVE)
  visibility DocumentVisibility @default(MEMBERS)
  committeeAccess String?
  effectiveDate DateTime?
  expiryDate    DateTime?
  reviewDate    DateTime?
  supersedes    String?
  supersededBy  String?
  relatedDocs   String[] @default([])
  keywords      String[] @default([])
  fullTextSearch String?
  ownerUserId   String?
  storageProvider StorageProvider @default(EXTERNAL_LINK)
  sourceExternalId String?
  sourceFolderId   String?
  sourceWebUrl     String?
  sourceMimeType   String?
  sourceModifiedAt DateTime?
  currentVersionId String? @unique
  currentVersion   DocumentVersion? @relation("CurrentDocumentVersion", fields: [currentVersionId], references: [id])

  // Multi-tenancy
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id])
  versions      DocumentVersion[] @relation("DocumentVersions")
  chunks        DocumentChunk[]
  ingestionJobs DocumentIngestionJob[]
  accessLogs    DocumentAccessLog[]
  accessRules   DocumentAccessRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DocumentVersion {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)

  cooperativeId String
  version       Int
  source        String
  storageProvider StorageProvider @default(EXTERNAL_LINK)
  sourceExternalId String?
  sourceFolderId   String?
  sourceWebUrl     String?
  storageUrl    String
  storageKey    String?
  fileType      String
  mimeType      String?
  sizeBytes     Int?
  checksum      String?

  ingestionStatus String @default("pending")
  ingestionError  String?
  ingestionStartedAt   DateTime?
  ingestionCompletedAt DateTime?
  ingestionDurationMs  Int?

  extractionMethod     String?
  extractionConfidence Float?
  chunkCount           Int?
  tokenCount           Int?

  extractedText String?
  summary       String?
  ragStatus       String    @default("not_indexed")
  ragStoreName    String?
  ragDocumentName String?
  ragIndexedAt    DateTime?
  ragIndexError   String?

  currentForDocument Document? @relation("CurrentDocumentVersion")
  chunks             DocumentChunk[]
  ingestionJobs      DocumentIngestionJob[]

  createdAt DateTime @default(now())

  @@unique([documentId, version])
  @@index([cooperativeId])
  @@index([documentId])
  @@index([ingestionStatus])
}

model DocumentAccessRule {
  id            String @id @default(uuid())
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  documentId    String
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  groupId       String?
  group         Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission    DocumentAccessLevel
  createdBy     String?
  createdAt     DateTime @default(now())

  @@index([cooperativeId])
  @@index([documentId])
  @@index([groupId])
  @@index([userId])
}

model DocumentChunk {
  id                String @id @default(uuid())
  documentId        String
  document          Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentVersionId String
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  cooperativeId     String

  chunkIndex    Int
  text          String
  tokenEstimate Int?

  category   String?
  committee  String?
  tags       String[] @default([])
  pageNumber Int?

  embedding         Json
  embeddingModel    String
  embeddingVersion  String
  isActive          Boolean @default(true)
  replacedAt        DateTime?
  replacedByBatchId String?
  chunkBatchId      String

  createdAt DateTime @default(now())

  @@index([cooperativeId])
  @@index([cooperativeId, isActive])
  @@index([documentId])
  @@index([documentVersionId])
  @@index([isActive])
  @@index([embeddingModel, embeddingVersion])
}

model DocumentIngestionJob {
  id                String @id @default(uuid())
  documentId        String
  document          Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentVersionId String
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  cooperativeId     String

  status      String @default("queued")
  attempts    Int @default(0)
  maxAttempts Int @default(3)
  nextRetryAt DateTime?
  error       String?
  errorStack  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cooperativeId])
  @@index([status, nextRetryAt])
  @@index([documentVersionId])
}

model PolicyAssistantQuery {
  id              String @id @default(uuid())
  cooperativeId   String
  userId          String
  question        String
  retrievedChunks Json
  answer          String
  citations       Json
  language        String @default("English")
  intent          String @default("policy")
  suggestedAction Json?
  userFeedback    String?
  feedback        String?
  feedbackReason  String?
  latencyMs       Int
  createdAt       DateTime @default(now())

  @@index([cooperativeId, createdAt])
  @@index([userId, createdAt])
}

model RagStore {
  id              String   @id @default(uuid())
  cooperativeId   String?
  cooperative     Cooperative? @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  scope           String
  displayName     String
  geminiStoreName String   @unique
  embeddingModel  String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([cooperativeId, scope])
  @@index([cooperativeId])
  @@index([scope])
}

model DocumentAccessLog {
  id         String @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String
  action     String
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([documentId, createdAt])
  @@index([userId, createdAt])
}

model CoopEvent {
  id          String   @id @default(uuid())
  title       String
  description String   @default("")
  date        DateTime // Changed from String to DateTime
  time        String
  location    String
  category    String

  // Multi-tenancy
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id])

  committeeId String?
  committee   Committee? @relation(fields: [committeeId], references: [id])

  attendees Tenant[]        @relation("EventAttendees")
  minutes   MeetingMinutes?
  meetingAnalyses MeetingAnalysis[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model Committee {
  id          String @id @default(uuid())
  name        String
  description String
  chair       String @default("")
  icon        String @default("fa-users")

  // Multi-tenancy
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id])

  events    CoopEvent[]
  members   Tenant[]    @relation("CommitteeMembers")
  groups    Group[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model MeetingMinutes {
  id            String    @id @default(cuid())
  meetingId     String    @unique
  meetingType   String // 'quick' | 'regular' | 'agm' | 'special'
  data          Json // Store the entire formData object
  attendees     Json // Array of attendees
  motions       Json // Array of motions
  cooperativeId String? // Added field
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdBy     String
  approvedBy    String?
  approvalDate  DateTime?

  meeting CoopEvent @relation(fields: [meetingId], references: [id])

  @@index([meetingId])
}

model MeetingAnalysis {
  id                  String   @id @default(cuid())
  meetingId           String?
  meeting             CoopEvent? @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  cooperativeId       String
  cooperative         Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  rawNotes            String
  professionalSummary String
  decisions           Json
  motionsMentioned    Json
  actionItems         Json
  risksOrFollowUps    Json
  createdBy           String
  approvedAt          DateTime?
  createdAt           DateTime @default(now())

  @@index([cooperativeId])
  @@index([meetingId])
  @@index([createdAt])
}

model ScheduledMaintenance {
  id            String               @id @default(uuid())
  unitId        String
  unit          Unit                 @relation("ScheduledTasks", fields: [unitId], references: [id], onDelete: Cascade)
  task          String
  description   String?
  frequency     MaintenanceFrequency
  dueDate       DateTime // Changed from String to DateTime
  lastCompleted DateTime? // Changed from String to DateTime
  assignedTo    String
  isCompleted   Boolean              @default(false)
  isActive      Boolean              @default(true)
  category      MaintenanceCategory

  // Multi-tenancy
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id            String @id @default(uuid())
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  actorUserId   String?
  actor         User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action        String
  entityType    String
  entityId      String?
  before        Json?
  after         Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([cooperativeId])
  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model MagicLinkToken {
  id            String   @id @default(uuid())
  cooperativeId String
  email         String
  tokenHash     String   @unique
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime @default(now())

  @@index([cooperativeId])
  @@index([email])
  @@index([expiresAt])
}
