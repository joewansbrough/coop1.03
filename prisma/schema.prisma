// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- ENUMS ---

enum MaintenanceFrequency {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum MaintenanceCategory {
  PLUMBING
  ELECTRICAL
  HVAC
  SAFETY
  GENERAL
  OTHER
}

enum DocumentVisibility {
  PUBLIC
  MEMBERS
  COMMITTEE
  BOARD
  ADMIN
}

enum DocumentStatus {
  ACTIVE
  ARCHIVED
  SUPERSEDED
}

// --- MODELS ---

model Cooperative {
  id         String   @id @default(uuid())
  name       String
  slug       String   @unique
  address    String?
  city       String?
  province   String   @default("BC")
  adminEmail String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  announcements        Announcement[]
  committees           Committee[]
  events               CoopEvent[]
  documents            Document[]
  maintenanceRequests  MaintenanceRequest[]
  scheduledMaintenance ScheduledMaintenance[]
  dashboardPreferences  DashboardPreference[]
  tenants              Tenant[]
  tenantHistories      TenantHistory[]
  units                Unit[]
}

model DashboardPreference {
  id            String   @id @default(uuid())
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  userEmail     String
  layout        Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([cooperativeId, userEmail])
  @@index([cooperativeId])
}

model Unit {
  id     String @id @default(uuid())
  number String @unique
  type   String // e.g., "1BR", "2BR", "3BR"
  floor  Int    @default(1)
  status String // e.g., "Occupied", "Vacant", "Maintenance"

  // Multi-tenancy
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id])

  currentTenantId String? @unique
  currentTenant   Tenant? @relation("CurrentResident", fields: [currentTenantId], references: [id])

  maintenanceHistory MaintenanceRequest[]
  occupancyHistory   TenantHistory[]
  scheduledTasks     ScheduledMaintenance[] @relation("ScheduledTasks")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tenant {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  email     String   @unique
  phone     String?
  startDate DateTime // Changed from String to DateTime
  status    String   @default("Current")
  role      String   @default("MEMBER")

  // Multi-tenancy
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id])

  unitId String?
  unit   Unit?   @relation("CurrentResident")

  committees Committee[]     @relation("CommitteeMembers")
  events     CoopEvent[]     @relation("EventAttendees")
  history    TenantHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TenantHistory {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  unitId   String
  unit     Unit   @relation(fields: [unitId], references: [id])

  // Multi-tenancy
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id])

  startDate  DateTime
  endDate    DateTime?
  moveReason String?
  createdAt  DateTime  @default(now())
}

model MaintenanceRequest {
  id          String @id @default(uuid())
  title       String
  description String
  status      String
  priority    String
  category    String @default("General")

  // Multi-tenancy
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id])

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id])

  tenantId    String?
  requestedBy String? // Email of the tenant who requested
  notes       Json?
  expenses    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Announcement {
  id       String   @id @default(uuid())
  title    String
  content  String
  type     String
  priority String   @default("Normal")
  author   String
  date     DateTime // Changed from String to DateTime

  // Multi-tenancy
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Document {
  id        String   @id @default(uuid())
  title     String
  category  String
  committee String?  @default("")
  url       String
  fileType  String
  author    String   @default("Admin")
  date      DateTime // Changed from String to DateTime
  tags      String[] @default([])
  content   String?
  status    DocumentStatus @default(ACTIVE)
  visibility DocumentVisibility @default(MEMBERS)
  committeeAccess String?
  effectiveDate DateTime?
  expiryDate    DateTime?
  reviewDate    DateTime?
  supersedes    String?
  supersededBy  String?
  relatedDocs   String[] @default([])
  keywords      String[] @default([])
  fullTextSearch String?
  currentVersionId String? @unique
  currentVersion   DocumentVersion? @relation("CurrentDocumentVersion", fields: [currentVersionId], references: [id])

  // Multi-tenancy
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id])
  versions      DocumentVersion[] @relation("DocumentVersions")
  chunks        DocumentChunk[]
  ingestionJobs DocumentIngestionJob[]
  accessLogs    DocumentAccessLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DocumentVersion {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)

  cooperativeId String
  version       Int
  source        String
  storageUrl    String
  storageKey    String?
  fileType      String
  mimeType      String?
  sizeBytes     Int?
  checksum      String?

  ingestionStatus String @default("pending")
  ingestionError  String?
  ingestionStartedAt   DateTime?
  ingestionCompletedAt DateTime?
  ingestionDurationMs  Int?

  extractionMethod     String?
  extractionConfidence Float?
  chunkCount           Int?
  tokenCount           Int?

  extractedText String?
  summary       String?

  currentForDocument Document? @relation("CurrentDocumentVersion")
  chunks             DocumentChunk[]
  ingestionJobs      DocumentIngestionJob[]

  createdAt DateTime @default(now())

  @@unique([documentId, version])
  @@index([cooperativeId])
  @@index([documentId])
  @@index([ingestionStatus])
}

model DocumentChunk {
  id                String @id @default(uuid())
  documentId        String
  document          Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentVersionId String
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  cooperativeId     String

  chunkIndex    Int
  text          String
  tokenEstimate Int?

  category   String?
  committee  String?
  tags       String[] @default([])
  pageNumber Int?

  embedding         Json
  embeddingModel    String
  embeddingVersion  String
  isActive          Boolean @default(true)
  replacedAt        DateTime?
  replacedByBatchId String?
  chunkBatchId      String

  createdAt DateTime @default(now())

  @@index([cooperativeId])
  @@index([cooperativeId, isActive])
  @@index([documentId])
  @@index([documentVersionId])
  @@index([isActive])
  @@index([embeddingModel, embeddingVersion])
}

model DocumentIngestionJob {
  id                String @id @default(uuid())
  documentId        String
  document          Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentVersionId String
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  cooperativeId     String

  status      String @default("queued")
  attempts    Int @default(0)
  maxAttempts Int @default(3)
  nextRetryAt DateTime?
  error       String?
  errorStack  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cooperativeId])
  @@index([status, nextRetryAt])
  @@index([documentVersionId])
}

model PolicyAssistantQuery {
  id              String @id @default(uuid())
  cooperativeId   String
  userId          String
  question        String
  retrievedChunks Json
  answer          String
  citations       Json
  userFeedback    String?
  feedbackReason  String?
  latencyMs       Int
  createdAt       DateTime @default(now())

  @@index([cooperativeId, createdAt])
  @@index([userId, createdAt])
}

model DocumentAccessLog {
  id         String @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String
  action     String
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([documentId, createdAt])
  @@index([userId, createdAt])
}

model CoopEvent {
  id          String   @id @default(uuid())
  title       String
  description String   @default("")
  date        DateTime // Changed from String to DateTime
  time        String
  location    String
  category    String

  // Multi-tenancy
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id])

  committeeId String?
  committee   Committee? @relation(fields: [committeeId], references: [id])

  attendees Tenant[]        @relation("EventAttendees")
  minutes   MeetingMinutes?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model Committee {
  id          String @id @default(uuid())
  name        String
  description String
  chair       String @default("")
  icon        String @default("fa-users")

  // Multi-tenancy
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id])

  events    CoopEvent[]
  members   Tenant[]    @relation("CommitteeMembers")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model MeetingMinutes {
  id            String    @id @default(cuid())
  meetingId     String    @unique
  meetingType   String // 'quick' | 'regular' | 'agm' | 'special'
  data          Json // Store the entire formData object
  attendees     Json // Array of attendees
  motions       Json // Array of motions
  cooperativeId String? // Added field
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdBy     String
  approvedBy    String?
  approvalDate  DateTime?

  meeting CoopEvent @relation(fields: [meetingId], references: [id])

  @@index([meetingId])
}

model ScheduledMaintenance {
  id            String               @id @default(uuid())
  unitId        String
  unit          Unit                 @relation("ScheduledTasks", fields: [unitId], references: [id], onDelete: Cascade)
  task          String
  description   String?
  frequency     MaintenanceFrequency
  dueDate       DateTime // Changed from String to DateTime
  lastCompleted DateTime? // Changed from String to DateTime
  assignedTo    String
  isCompleted   Boolean              @default(false)
  isActive      Boolean              @default(true)
  category      MaintenanceCategory

  // Multi-tenancy
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
